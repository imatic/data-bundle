{
    "name": "imatic/data-bundle",
    "type": "symfony-bundle",
    "description": "Bundle to work with data",
    "keywords": ["data", "symfony"],
    "homepage": "https://www.imatic.cz",
    "license": "MIT",
    "authors": [
        {
            "name": "Stepan Koci",
            "email": "stepan.koci@imatic.cz"
        },
        {
            "name": "Imatic Software s.r.o.",
            "homepage": "https://www.imatic.cz"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.2",
        "symfony/framework-bundle": "^8.1"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.0",
        "doctrine/orm": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.75",
        "imatic/form-bundle": "^6.0",
        "imatic/testing": "^7.0",
        "mikey179/vfsstream": "^1.4",
        "phpstan/phpstan": "^2.0",
        "symfony/browser-kit": "^8.1",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "suggest": {
        "doctrine/dbal": "*",
        "doctrine/orm": "*"
    },
    "autoload": {
        "psr-4": {
            "Imatic\\Bundle\\DataBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Imatic\\Bundle\\DataBundle\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
